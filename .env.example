# Copy to .env.local and fill in. Values for the shared project are in the
# Supabase dashboard under Project Settings → API.
#
# Nothing here is secret except the last one, which is why the last one is the
# only one without a NEXT_PUBLIC_ prefix. Next.js inlines any NEXT_PUBLIC_ value
# into the client bundle at build time, so that prefix is a declaration that the
# value is public, not a convenience.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Bypasses row-level security entirely, so it belongs on a developer's
# machine or in CI and nowhere near the app. Only scripts/seed-catalog.mjs reads
# it; without it that script needs the temporary seeding policy instead.
SUPABASE_SERVICE_ROLE_KEY=
